# Copy to services/catalog/.env for anything other than the default.
# The file is read by src/env.ts through process.loadEnvFile, and a variable
# already present in the environment always wins, so CI and one-off overrides
# such as `DATABASE_URL=... npm run catalog -- status` are never shadowed.
#
# .gitignore already covers .env* except .env.example. Never commit a real one.

# The catalog database. This default is the Homebrew Postgres 17 install with a
# database created by `createdb self_learn`, which is what daily development
# runs against — no container, no password, no configuration.
#
# CI and the homeserver run the postgres:17 container in compose.yaml instead:
#   DATABASE_URL=postgres://catalog:catalog@localhost:5432/self_learn
DATABASE_URL=postgres://localhost:5432/self_learn
