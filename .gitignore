# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies. Any depth: npm nests a workspace's own copy under it when
# the root already holds a different major of the same package.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (the app lives in apps/web, so these are not anchored to the root)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# learning pipeline: `learn/state/` is gone. model.json, reviews.json,
# events.jsonl and index.json are the mastery, review and event tables plus a
# query; `npm run catalog -- backfill` moved them and verified the move.
# Nothing writes the directory any more, and an entry pretending otherwise
# would only suggest something still does.

# Obsidian vault state (per-machine editor config)
.obsidian/

# Worktrees Claude Code materialises for background agents. Each is a full
# checkout of this repo inside this repo, so committing one would nest the
# tree in itself; the agents that built the asset library ran four at once.
# They are removed when an agent finishes, and this is the guard for the
# window where they are not.
.claude/worktrees/

# Another agent harness's copy of this repo's skills (.agents/skills/, the
# video-router skill with `.claude/` paths rewritten), written on a machine
# that runs one. The skills live under .claude/skills/; the copy is that
# machine's, and committing it would give the repo two versions that drift.
.agents/

# The diagram studio runner's own state: one directory per job, holding the
# write-ahead log, the agent transcript, the per-job permission file and the
# scratch the agent writes snippets into. None of it is knowledge base, and the
# permission file names this machine's home directory. STUDIO_HOME moves it
# somewhere else entirely, the way MANIMKC_HOME moves manimkc's data root.
/.studio/

# Third-party product screenshots gathered for design research stay local (copyright); our own current-app captures are tracked.
docs/design/research/assets/*
!docs/design/research/assets/current-app/

# docs/design/reference/<slug> is an absolute symlink into the private
# design-systems library, created per machine by
# scripts/link-design-systems.py. Tracking one would bake a machine path
# into the tree and dangle for everyone else, so only LINKS and the README
# are committed.
docs/design/reference/*
!docs/design/reference/LINKS
!docs/design/reference/README.md
**/.build/
