# Postgres holding the catalog: the content index and the learner state.
# Optional locally — it defaults to the Homebrew install's `self_learn`
# database. Required in production once a cloud database exists; without it
# the app renders read-only and says so. See docs/DEPLOYMENT.md and
# services/catalog/.env.example.
DATABASE_URL=postgres://localhost:5432/self_learn

# Canonical origin that social preview images resolve against. Optional:
# on Vercel the production domain is used automatically, and locally this
# falls back to http://localhost:3000. Scheme optional; https is assumed.
NEXT_PUBLIC_SITE_URL=https://self-learn-one.vercel.app

# Free production cascade for Launch Agent (no Grok/xAI in prod)
# Order: NVIDIA → Gemini Flash → OpenRouter free

# Each provider takes an optional *_MODEL and an optional *_BASE_URL. Both
# default to the values below, so the cascade works with only a key set. The
# base URLs exist to point a provider at a proxy or at a local mock: exercising
# a fallback path against real endpoints spends free-tier quota, and a
# self-hoster fronting one with a gateway should not have to edit
# apps/web/src/lib/agent/providers.ts.

# Primary — NVIDIA NIM (OpenAI-compatible, build.nvidia.com / integrate.api.nvidia.com)
NVIDIA_API_KEY=
# Optional override; default meta/llama-3.1-8b-instruct
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# Optional override; default https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Backup — Google Gemini free tier (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# Optional override; default gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Optional override; default https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Final free backup — OpenRouter free models
OPENROUTER_API_KEY=
# Optional override; default openrouter/free (auto-picks free models)
OPENROUTER_MODEL=openrouter/free
# Optional override; default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution on OpenRouter's dashboard. Optional: it falls back to
# NEXT_PUBLIC_SITE_URL above, so a fork is credited to its own domain rather
# than to this one.
OPENROUTER_HTTP_REFERER=https://self-learn-one.vercel.app
OPENROUTER_APP_TITLE=Self-Learn

# Serve indexed asset files (videos, diagrams, transcripts) at
# /api/assets/<id>/file. Off unless set, and deliberately not keyed on
# NODE_ENV: the documented way to look at this app locally is a production
# build, so a NODE_ENV gate would be off on the one machine that has the
# files. Production has none of them (the deployed bundle carries the course
# YAML and nothing else, and manimkc's renders live on a laptop), so leaving
# this unset there is what makes every request a 404 instead of a stat.
# The route needs a manimkc index that recorded its data root:
# `npm run catalog -- index --only manimkc`.
ASSET_FILES_ENABLED=
