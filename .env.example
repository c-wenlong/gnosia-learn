# Copy this file to apps/web/.env.local. Next loads .env files from the
# directory it starts in, which is apps/web/ since the app moved there; a copy
# at the repository root is never read.
# Who may open the app. Gnosia has one reader, so signing in is proving you
# hold this password; the session is a signed cookie (apps/web/src/lib/auth).
# Both are required before anyone can sign in, locally and on Vercel: with
# either missing every page except the landing redirects to /sign-in, which
# names the missing variable. Pick a long password; guessing is rate limited
# (apps/web/src/lib/auth/sign-in-limit.ts). Changing it signs every browser out.
OWNER_PASSWORD=
# Signs the session cookie (with the password and SESSION_EPOCH) and seals the
# provider keys saved in Settings. At least 32 characters:
# `openssl rand -base64 32`. Rotating it signs every browser out and makes the
# saved keys unreadable, so to sign everyone out bump SESSION_EPOCH instead.
AUTH_SECRET=
# Optional. Any value; change it (1, 2, ...) to sign every browser out without
# touching the password, AUTH_SECRET or the saved provider keys.
# SESSION_EPOCH=

# The catalog (the content index and the learner state) is one SQLite file:
# $GNOSIA_HOME/catalog.db, or ~/.gnosia/catalog.db when GNOSIA_HOME is unset
# (docs/SQLITE-MIGRATION.md). Nothing to set for daily development. To use
# another file, set CATALOG_DB to its path in services/catalog/.env, which the
# catalog CLI and the app both read; see services/catalog/.env.example. A
# postgres:// value is refused.
# CATALOG_DB=~/.gnosia/catalog.db

# Canonical origin that social preview images resolve against. Optional:
# on Vercel the production domain is used automatically, and locally this
# falls back to http://localhost:3000. Scheme optional; https is assumed.
NEXT_PUBLIC_SITE_URL=https://gnosia-one.vercel.app

# Free production cascade for Launch Agent (no Grok/xAI in prod)
# Order: NVIDIA → Gemini Flash → OpenRouter free

# Each provider takes an optional *_MODEL and an optional *_BASE_URL. Both
# default to the values below, so the cascade works with only a key set. The
# base URLs exist to point a provider at a proxy or at a local mock: exercising
# a fallback path against real endpoints spends free-tier quota, and a
# self-hoster fronting one with a gateway should not have to edit
# packages/tutor/src/providers.ts.

# Primary — NVIDIA NIM (OpenAI-compatible, build.nvidia.com / integrate.api.nvidia.com)
NVIDIA_API_KEY=
# Optional override; default google/gemma-4-31b-it
NVIDIA_MODEL=google/gemma-4-31b-it
# Optional override; default https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Backup — Google Gemini free tier (OpenAI-compatible endpoint)
GEMINI_API_KEY=
# Optional override; default gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Optional override; default https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Final free backup — OpenRouter free models
OPENROUTER_API_KEY=
# Optional override; default openrouter/free (auto-picks free models)
OPENROUTER_MODEL=openrouter/free
# Optional override; default https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Attribution on OpenRouter's dashboard. Optional: it falls back to
# NEXT_PUBLIC_SITE_URL above, so a fork is credited to its own domain rather
# than to this one.
OPENROUTER_HTTP_REFERER=https://gnosia-one.vercel.app

# The other providers (docs/TUTOR-MODELS.md, T13): OPENAI, ANTHROPIC,
# DEEPSEEK, GLM, QWEN, MOONSHOT, MINIMAX, MIMO, MISTRAL, GROQ, XAI. A server
# key is opt-in under the TUTOR_ prefix, never the bare ANTHROPIC_API_KEY or
# OPENAI_API_KEY a shell may export for other tools. Usually leave these
# unset and save keys in Settings, Providers instead. Each also takes
# TUTOR_<ID>_MODEL and TUTOR_<ID>_BASE_URL.
# TUTOR_OPENAI_API_KEY=
# TUTOR_ANTHROPIC_API_KEY=

# How long one provider call may take, and a whole tutor turn walking the
# providers or the owner's model chain (docs/TUTOR-MODELS.md, T10). Optional,
# in milliseconds, between 1000 and 300000; defaults 20000 and 60000.
TUTOR_ATTEMPT_TIMEOUT_MS=20000
TUTOR_TURN_DEADLINE_MS=60000
OPENROUTER_APP_TITLE=Gnosia

# Where the laptop's blob store keeps its objects: $GNOSIA_HOME/blobs, or
# ~/.gnosia/blobs when unset (docs/CONTENT-MIGRATION.md 0.4). The notes
# vault `learn vault pull` writes defaults to $GNOSIA_HOME/vault. Absolute or
# starting with ~/; a relative value is refused. Outside the repository on
# purpose, since a git operation can delete anything inside it.
# Set it in services/catalog/.env rather than here: the catalog CLI that
# uploads reads that file and never this one, and the app reads the root
# through the catalog's blobRoot(), which reads that file too. Set here alone,
# the app would serve from one store and the CLI upload to another.
# GNOSIA_HOME=~/.gnosia
